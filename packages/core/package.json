{
  "name": "@retenia/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure domain logic. Zero Electron, Node, or AI-provider SDK imports — depends only on ports.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "biome check ."
  },
  "dependencies": {
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@retenia/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
