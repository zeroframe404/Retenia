      "id": "id-7",
      "locator": {
        "anchor": "4",
      },
      "text": "def is_alive(cell):
    return cell.has_membrane and cell.has_dna",
      "type": "code",
    },
    {
      "hash": "222b47c10254f147c7859aaf7074a19a070e6c221764f7fdcc3b124e6b370992",
      "id": "id-9",
      "locator": {
        "anchor": "5",
      },
      "text": "Mitosis produces two identical daughter cells from one parent cell.",
      "type": "paragraph",
    },
