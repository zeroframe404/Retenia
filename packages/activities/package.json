{
  "name": "@retenia/activities",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Activity engine UI: <ActivityHost/>, the type registry, one renderer per family and the shared activity components.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "storybook": "storybook dev -p 6007 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@retenia/activity-graders": "workspace:*",
    "@retenia/activity-schema": "workspace:*",
    "@retenia/core": "workspace:*",
    "@retenia/ui": "workspace:*",
    "konva": "10.3.3",
    "lucide-react": "1.39.0",
    "mathlive": "0.110.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.6"
  },
  "devDependencies": {
    "@retenia/config": "workspace:*",
    "@retenia/i18n": "workspace:*",
    "@storybook/addon-a11y": "10.2.0",
    "@storybook/react-vite": "10.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "i18next": "26.4.1",
    "jsdom": "30.0.1",
    "react-i18next": "17.0.13",
    "storybook": "10.2.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
