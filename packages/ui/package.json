{
  "name": "@retenia/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design system: Tailwind tokens, components, Motion presets, icons.",
  "exports": {
    ".": "./src/index.ts",
    "./charts": "./src/components/charts.tsx",
    "./theme.css": "./src/theme.css",
    "./fonts/*": "./fonts/*",
    "./sounds/*": "./sounds/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@lottiefiles/dotlottie-react": "0.19.16",
    "@retenia/core": "workspace:*",
    "@rive-app/react-canvas": "4.33.1",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.18.5",
    "lucide-react": "1.39.0",
    "mermaid": "11.17.2",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@retenia/config": "workspace:*",
    "@retenia/i18n": "workspace:*",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/react-vite": "10.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/canvas-confetti": "1.9.0",
    "@types/katex": "0.16.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "hast-util-sanitize": "5.0.2",
    "i18next": "26.4.1",
    "i18next-icu": "2.4.4",
    "jsdom": "30.0.1",
    "react-i18next": "17.0.13",
    "storybook": "10.2.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
