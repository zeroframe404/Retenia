{
  "name": "@retenia/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared base tsconfig and Tailwind preset. Biome/formatting is applied repo-wide by the root biome.json (Biome has no per-package composition story worth duplicating here).",
  "exports": {
    ".": "./src/index.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tailwind.preset": "./tailwind.preset.ts",
    "./vitest.base": "./vitest.base.ts",
    "./vitest.setup": "./vitest.setup.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
