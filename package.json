{
  "name": "retenia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings . && node tooling/scripts/check-deps.mjs && turbo run lint",
    "test:coverage": "vitest run --coverage",
    "e2e": "turbo run e2e",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "format": "biome check --write .",
    "licenses:check": "node tooling/scripts/check-licenses.mjs",
    "schema:check": "pnpm --filter @retenia/activity-schema run schema:check",
    "i18n:check": "node tooling/scripts/i18n-check.mjs",
    "contrast:check": "node tooling/scripts/contrast-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@vitest/coverage-v8": "4.1.11",
    "turbo": "2.10.12",
    "vitest": "4.1.11"
  }
}
