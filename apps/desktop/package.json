{
  "name": "@retenia/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroframe404/retenia.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "lint": "biome check .",
    "pack": "electron-vite build && electron-builder --dir",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6007 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@retenia/activities": "workspace:*",
    "@retenia/activity-schema": "workspace:*",
    "@retenia/core": "workspace:*",
    "@retenia/db": "workspace:*",
    "@retenia/i18n": "workspace:*",
    "@retenia/ipc-contract": "workspace:*",
    "@retenia/ui": "workspace:*",
    "@sentry/electron": "7.18.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "i18next": "26.4.1",
    "i18next-icu": "2.4.4",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "5.3.3",
    "react-i18next": "17.0.13",
    "react-resizable-panels": "4.12.3",
    "sqlite-vec": "0.1.9",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@retenia/config": "workspace:*",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/react-vite": "10.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "storybook": "10.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unzipper": "0.12.5",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@open-spaced-repetition/binding": "0.5.0"
  }
