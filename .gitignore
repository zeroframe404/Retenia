# Dependencies
node_modules/
.pnpm-store/

# Turborepo
.turbo/

# Build outputs
dist/
out/
build/
# electron-builder's `buildResources` dir (electron-builder.yml) — tracked source
# (the fuses afterPack hook, eventually icons/installer assets), not build output.
!apps/desktop/build/
*.tsbuildinfo

# Electron-builder
release/
!.claude/skills/release/

# Testing
coverage/
playwright-report/
test-results/
apps/desktop/e2e/__screenshots__/*.png

# Storybook
storybook-static/

# tesseract.js caches the language traineddata it downloads in the current working
# directory unless a cachePath is configured — harmless locally, never committed.
*.traineddata

# Sidecar binaries (ffmpeg, whisper-cli — sub-phase 6.4). `node tooling/download-sidecars.ts
# --install` puts the pinned, hash-verified builds here for development; the shipped app
# downloads them into userData/bin at first use instead. Hundreds of megabytes of third-party
# executables, never committed.
.sidecars/
# The same binaries in the location electron-builder would package them from. `resources/bin`
# is an `asarUnpack` target in electron-builder.yml, so anything left here really would ship.
apps/desktop/resources/bin/

# Python virtualenv of the fixture generator (tooling/fsrs-fixtures/README.md)
.venv/

# Env & local-only config
.env
.env.*
!.env.example
*.local.json

# Electron userData fixtures (local test profiles, never committed)
**/fixtures/userData/
**/.userData/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# pnpm evals (tooling/evals): the spend ledger and promptfoo's raw JSON are per-run
# scratch state, not the deliverable — that is docs/evals/<date>.md, which is committed.
tooling/evals/.spend-ledger.json
tooling/evals/.last-results.json
